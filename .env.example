# ---- Notification channels: configure one or more ---------------------------------

# ntfy.sh: the zero-setup channel. People subscribe to this topic in the free ntfy app
# (or in the browser at https://ntfy.sh/<topic>). No accounts. Anyone who knows the topic
# name can also post to it, so keep the random suffix.
NTFY_TOPIC=

# Telegram: bot token from @BotFather; chat id may be a private chat, a group, or a
# channel like "@woplaysi" (add the bot as channel admin). TELEGRAM_JOIN_URL is the
# public invite link shown on the status page.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_JOIN_URL=

# E-mail via any SMTP account (Gmail: smtp.gmail.com, port 465, an "app password").
# EMAIL_TO is a comma-separated list; everyone is put in BCC. The simplest self-service
# setup is a Google Group: EMAIL_TO=<group address>, EMAIL_SUBSCRIBE_URL=<group join link>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBSCRIBE_URL=

# ---- Optional ----------------------------------------------------------------------

# Public address of the status page (used in e-mail footers and the feed).
SITE_URL=

# How far above Sony's list price still counts as a fair offer. 0.15 = 15 %.
PRICE_TOLERANCE=0.15

# Added to the User-Agent so shops can reach you. Leave empty to omit.
CONTACT_EMAIL=
